<Window x:Class="WpfAppEfCoreDI.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppEfCoreDI.Presentation.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="#ffffff"
                        Padding="10, 5" CornerRadius="5" SnapsToDevicePixels="True">
                            <TextBlock x:Name="ButtonTextBlock" Text="{TemplateBinding Content}" 
                                       TextAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#d8d8d8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Background="#ff0050b0">
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <Button Content="List Product" Margin="0,0,12,0" Padding="10,4" Width="100" Command="{Binding NavigateToListProductsPageCommand}"/>
                <Button Content="Create Product" Width="100" Padding="10,4" Command="{Binding NavigateToCreatePageCommand}"/>
            </StackPanel>
        </Grid>
        <Frame Grid.Row="1" x:Name="ContentFrame" 
               NavigationUIVisibility="Hidden" 
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
