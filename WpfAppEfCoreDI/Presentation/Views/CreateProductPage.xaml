<Page x:Class="WpfAppEfCoreDI.Presentation.Views.CreateProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppEfCoreDI.Presentation.Views"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="800"
      d:Background="White"
      Title="CreateProductPage">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="#ff0050b0" 
                                CornerRadius="5" SnapsToDevicePixels="True"
                                Width="80" Height="20">
                            <TextBlock x:Name="ButtonTextBlock" Text="{TemplateBinding Content}" 
                                       Foreground="White"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ff0056b6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="25" />
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid>
        <StackPanel 
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBox Text="{Binding Name}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Price" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBox PreviewTextInput="AllowPriceOnly" Text="{Binding Price}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Short Description" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBox Text="{Binding ShortDescription}"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Quantity" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBox PreviewTextInput="AllowQuantityOnly" Text="{Binding Quantity}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                <Button Content="Create" Margin="0,0,10,0" Command="{Binding CreateProductCommand}"/>
                <Button Content="Clear" Command="{Binding ClearInputCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
